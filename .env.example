# BizNex AI Configuration
# Get your free API keys from:
# Groq: https://console.groq.com (ultra-fast AI, free tier: 14,400 req/day)
# Gemini: https://aistudio.google.com (Google's AI, free tier: 60 req/min)
# Supabase: https://supabase.com (Auth & Database, free tier: 500MB)

# ============================================
# SERVER-SIDE API KEYS (for Vercel serverless functions)
# These are NOT exposed to the browser
# ============================================

# Primary AI Provider (Fast - for chat & quick responses)
# On Vercel: Set as VITE_GROQ_API_KEY or GROQ_API_KEY in Environment Variables
GROQ_API_KEY=

# Fallback AI Provider (Best for complex analysis)
# On Vercel: Set as VITE_GEMINI_API_KEY or GEMINI_API_KEY in Environment Variables
GEMINI_API_KEY=

# ============================================
# CLIENT-SIDE KEYS (exposed to browser)
# ============================================

# Supabase (Authentication & Database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
